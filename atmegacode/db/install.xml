<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/assign/submission/atmegacode/db" VERSION="2025080602" COMMENT="Install XML for ATmega code plugin"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="../../../../lib/xmldb/xmldb.xsd">

    <TABLES>

        <!-- Main submission table -->
        <TABLE NAME="assignsubmission_atmegacode" COMMENT="Stores metadata about ATmega code submissions">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="assignment" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
                <FIELD NAME="submission" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
                <FIELD NAME="filename" TYPE="char" LENGTH="255" NOTNULL="false"/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="submission_fk" TYPE="foreign" FIELDS="submission" REFTABLE="assign_submission" REFFIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="assignment_idx" UNIQUE="false" FIELDS="assignment"/>
            </INDEXES>
        </TABLE>

        <!-- Flags table for warnings and cheating detection -->
        <TABLE NAME="assignsubmission_atmegacode_flags" COMMENT="Stores precheck warnings per submission">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="submissionid" TYPE="int" LENGTH="10" NOTNULL="true"/>
                <FIELD NAME="warnings" TYPE="text" NOTNULL="false"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
        </TABLE>

    </TABLES>
</XMLDB>
